PORT=4000
LOG_LEVEL=info
# 10143 = Monad testnet, 31337 = local anvil. Mainnet (143) is refused.
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
WS_URL=wss://testnet-rpc.monad.xyz
DATABASE_URL=file:./data/jitu.db
DEMO_MODE=true
MULTI_HUMAN_QUEUE=false

# hybrid = Pyth with CoinGecko fallback; hermes | hybrid | mock. Defaults to mock on anvil and hermes on testnet.
PRICE_SOURCE=hybrid
COINGECKO_POLL_MS=10000
PYTH_HERMES_URL=https://hermes.pyth.network
# Required for PRICE_SOURCE=hermes or hybrid since Pyth's 2026-08-26 Core upgrade (Pyth Terminal key, sent as a Bearer token).
PYTH_API_KEY=

# Never commit real keys. The keeper needs SEASON_MANAGER_ROLE + RESULT_POSTER_ROLE and > 10 MON.
KEEPER_PRIVATE_KEY=
# bytes32, generated once per contract deployment: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
GAME_ID_SALT=
# Monad testnet deployment (contracts/deployments/10143.json, commit 34dc35d). For anvil, see docs/BACKEND_PLAN.md §8.
MOCK_USD_ADDRESS=0x888054c88594D673f3C77CE99Aa73373ACfA1BdC
SEASON_VAULT_ADDRESS=0x87e83410FD37F6FfC37BC709DaA7DE7B64460266
GAME_MANAGER_ADDRESS=0x699834468547F56E38F87bFeeD15b3B2D6e343ff
# Indexer backfill starts here (the deploy block).
INDEXER_START_BLOCK=73722191

SIWE_DOMAIN=localhost:3000
# At least 32 characters.
SESSION_SECRET=
CORS_ORIGIN=http://localhost:3000
