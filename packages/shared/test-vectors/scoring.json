{
  "_comment": "Crypto Draft scoring vectors. Prices are raw integers as strings; with start 10000 a move of N equals N bps. Every expected value is hand-computed with truncation toward zero.",
  "pickReturns": [
    { "name": "buy up", "pick": { "side": "Buy", "start": "10000", "end": "10050" }, "expected": { "raw": 50, "ret": 50, "void": false } },
    { "name": "sell up loses", "pick": { "side": "Sell", "start": "10000", "end": "10050" }, "expected": { "raw": -50, "ret": -50, "void": false } },
    { "name": "under 1 bps is void", "pick": { "side": "Buy", "start": "1000000", "end": "1000099" }, "expected": { "raw": 0, "ret": 0, "void": true } },
    { "name": "negative truncates toward zero", "pick": { "side": "Buy", "start": "3", "end": "2" }, "expected": { "raw": -3333, "ret": -3333, "void": false } },
    { "name": "sell negative truncates toward zero", "pick": { "side": "Sell", "start": "3", "end": "4" }, "expected": { "raw": -3333, "ret": -3333, "void": false } },
    { "name": "insured loss floors at 0 but is not void", "pick": { "side": "Buy", "insured": true, "start": "10000", "end": "9970" }, "expected": { "raw": -30, "ret": 0, "void": false } },
    { "name": "LOCK keeps the gain", "pick": { "side": "Buy", "start": "10000", "end": "9800", "effect": { "kind": "LOCK", "price": "10100" } }, "expected": { "raw": 100, "ret": 100, "void": false } },
    { "name": "FREEZE caps a winner", "pick": { "side": "Buy", "start": "10000", "end": "10090", "effect": { "kind": "FREEZE", "price": "10020" } }, "expected": { "raw": 20, "ret": 20, "void": false } },
    { "name": "FLIP on a rising pick", "pick": { "side": "Buy", "start": "10000", "end": "10051", "effect": { "kind": "FLIP", "price": "10030" } }, "expected": { "raw": 10, "ret": 10, "void": false } },
    { "name": "FLIP backfires", "pick": { "side": "Buy", "start": "10000", "end": "10009", "effect": { "kind": "FLIP", "price": "10030" } }, "expected": { "raw": 50, "ret": 50, "void": false } },
    { "name": "FLIP segments cancel to void", "pick": { "side": "Buy", "start": "10000", "end": "10021", "effect": { "kind": "FLIP", "price": "10010" } }, "expected": { "raw": 0, "ret": 0, "void": true } },
    { "name": "SWAP onto a falling coin", "pick": { "side": "Buy", "start": "10000", "end": "10500", "effect": { "kind": "SWAP", "price": "10025", "newCoin": "DOGE", "newStart": "20000", "newEnd": "19920" } }, "expected": { "raw": -15, "ret": -15, "void": false } },
    { "name": "SWAP keeps the victim's Sell", "pick": { "side": "Sell", "start": "10000", "end": "10000", "effect": { "kind": "SWAP", "price": "9990", "newCoin": "SOL", "newStart": "5000", "newEnd": "5010" } }, "expected": { "raw": -10, "ret": -10, "void": false } },
    { "name": "INSURANCE floors after a FLIP", "pick": { "side": "Buy", "insured": true, "start": "10000", "end": "10061", "effect": { "kind": "FLIP", "price": "10010" } }, "expected": { "raw": -40, "ret": 0, "void": false } }
  ],
  "rounds": [
    { "name": "single confident pick", "cap": 3, "picks": [{ "side": "Buy", "start": "10000", "end": "10050" }], "expected": 150 },
