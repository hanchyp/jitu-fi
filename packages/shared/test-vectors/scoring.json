    ], "expected": 40 },
    { "name": "all void scores 0", "cap": 1, "picks": [{ "side": "Sell", "start": "1000000", "end": "1000050" }], "expected": 0 },
    { "name": "forfeit scores 0", "cap": 3, "forfeit": true, "picks": [{ "side": "Buy", "start": "10000", "end": "10050" }], "expected": 0 },
    { "name": "no picks scores 0", "cap": 2, "picks": [], "expected": 0 },
    { "name": "negative round truncates toward zero", "cap": 2, "picks": [
      { "side": "Buy", "start": "10000", "end": "9990" },
